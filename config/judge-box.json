{
  "executionMode": "docker",
  "port": 3001,
  "enableRedis": true,
  "logLevel": "info",
  "laravel": {
    "internalUrl": "http://127.0.0.1:8001/api/v1",
    "secretToken": "judge-secret-token"
  },
  "redis": {
    "url": "redis://127.0.0.1:6379",
    "prefix": "programmersarena_database_",
    "host": "127.0.0.1",
    "port": 6379,
    "db": 0,
    "jobQueueKey": "judge:jobs",
    "resultQueueKey": "judge:results",
    "maxRetries": 3
  },
  "defaults": {
    "timeLimit": 1,
    "memoryLimit": 256
  },
  "testCache": {
    "dir": "/var/cache/judge/tests"
  },
  "docker": {
    "registry": "",
    "networkMode": "none",
    "memorySwap": "off",
    "autoPullMissingImages": false,
    "sandboxFlags": "--pids-limit 64 --cpus 4 --cap-drop=ALL --security-opt no-new-privileges"
  },
  "isolate": {
    "enabled": true,
    "cgroupsVersion": 2,
    "boxBaseDir": "/var/lib/isolate",
    "maxBoxes": 32,
    "enableCgroup": 1,
    "enableCgroupMemory": true,
    "enableCgroupCpu": true,
    "enableCgroupPids": true,
    "stackLimit": 8192,
    "fileUploadLimit": 104857600,
    "outputTruncateBytes": 1000000
  },
  "ioi": {
    "testConcurrency": 1
  },
  "reaper": {
    "staleMs": 300000,
    "scanIntervalMs": 30000
  },
  "languages": {
    "gcc": {
      "dockerImage": "gcc",
      "commandCompile": "g++ /submission/submission.cpp -o /submission/executable",
      "commandCompileGrader": "g++ -o /submission/executable /submission/grader.cpp",
      "execute": "/submission/executable",
      "versions": ["10"],
      "extension": "cpp"
    },
    "python": {
      "dockerImage": "python",
      "execute": "python /submission/submission.py",
      "versions": ["3.10"],
      "extension": "py"
    },
    "php": {
      "dockerImage": "php",
      "execute": "php /submission/submission.php",
      "versions": ["8.0"],
      "extension": "php"
    },
    "freepascal": {
      "dockerImage": "freepascal",
      "commandCompile": "fpc -O2 -o/submission/executable /submission/submission.pas",
      "commandCompileGrader": "fpc -O2 -o/submission/executable /submission/grader.pas",
      "execute": "/submission/executable",
      "versions": ["3.2.2"],
      "extension": "pas"
    },
    "golang": {
      "dockerImage": "golang",
      "commandCompile": "go build -o /submission/executable /submission/submission.go",
      "execute": "/submission/executable",
      "versions": ["1.21.6"],
      "extension": "go"
    },
    "java": {
      "dockerImage": "openjdk",
      "commandCompile": "javac /submission/submission.java -d /submission/classes",
      "commandCompileGrader": "javac /submission/Grader.java /submission/submission.java -d /submission/classes",
      "execute": "java -cp /submission/classes Grader",
      "versions": ["8", "11", "17"],
      "extension": "java"
    },
    "javascript": {
      "dockerImage": "node",
      "execute": "node /submission/submission.js",
      "versions": ["12", "14", "16"],
      "extension": "js"
    },
    "rust": {
      "dockerImage": "rust",
      "commandCompile": "rustc /submission/submission.rs -o /submission/executable",
      "commandCompileGrader": "rustc -o /submission/executable /submission/submission.rs /submission/submission.rs",
      "execute": "/submission/executable",
      "versions": ["1.70", "1.75", "stable"],
      "extension": "rs"
    }
  }
}
