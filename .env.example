# Judge-Box environment example
LARAVEL_INTERNAL_URL=http://127.0.0.1:8001/api/v1

# Execution mode: 'docker' (dev) or 'isolate' (production)
EXEC_MODE=docker

# Enable Redis queue worker (1 = enabled)
ENABLE_REDIS=1

# Redis connection used for judge:jobs and judge:results
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=programmersarena_database_

# HTTP port the daemon listens on
PORT=3001

# Defaults for job execution (can be overridden per job)
DEFAULT_TIME_LIMIT=1        # seconds
DEFAULT_MEMORY_LIMIT=256    # MB

# Isolate specific settings (used when EXEC_MODE=isolate)
ISOLATE_BOX_BASE=/var/lib/isolate
ISOLATE_MAX_BOXES=32
ISOLATE_CGROUP_ENABLE=1

JUDGE_TEST_CACHE_DIR=/var/cache/judge/tests
LARAVEL_INTERNAL_URL=http://localhost8001/api/v1
JUDGE_SECRET_TOKEN=judge-secret-token

# Logging
LOG_LEVEL=info

# Optional: Docker image registry prefix (if using private images)
DOCKER_REGISTRY=
