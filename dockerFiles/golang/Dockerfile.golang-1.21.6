FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    wget \
    ca-certificates \
    time \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://go.dev/dl/go1.21.6.linux-amd64.tar.gz && \
    tar -C /usr/local -xzf go1.21.6.linux-amd64.tar.gz && \
    rm go1.21.6.linux-amd64.tar.gz

ENV PATH="/usr/local/go/bin:${PATH}"
ENV GOPATH="/go"
ENV PATH="${GOPATH}/bin:${PATH}"

ENV GO111MODULE=off
ENV CGO_ENABLED=0
ENV GOPROXY=off
ENV GOSUMDB=off
ENV GOTOOLCHAIN=local
ENV GOFLAGS=-mod=mod

WORKDIR /workspace

RUN mkdir -p /tmp/warmup && \
    printf 'package main\nimport "fmt"\nfunc main() { fmt.Println("warmup") }\n' > /tmp/warmup/main.go && \
    go build -o /tmp/warmup/main /tmp/warmup/main.go && \
    rm -rf /tmp/warmup

CMD ["/bin/bash"]